<CommonControls:BaseControl x:Class="Diffuse.Controls.LoraAdapterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:base="clr-namespace:Diffuse"
             xmlns:local="clr-namespace:Diffuse.Controls"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:CommonConverters="clr-namespace:TensorStack.WPF.Converters;assembly=TensorStack.WPF"
             xmlns:Controls="clr-namespace:Diffuse.Controls"
             xmlns:Common="clr-namespace:Diffuse.Common"
             xmlns:Views="clr-namespace:Diffuse.Views">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:LoraAdapterControl}}}">

        <UniformGrid Columns="1">

            <!--LoraAdapter1-->
            <DockPanel>
                <UniformGrid Columns="1" DockPanel.Dock="Right" Width="20">
                    <Button Command="{Binding AddCommand}">
                        <CommonControls:FontAwesome Icon="2b" Size="9" Margin="0,1,0,0"/>
                    </Button>
                </UniformGrid>
                <Grid>
                    <ComboBox x:Name="ComboBoxLora0"
                        SelectedItem="{Binding LoraAdapters[0]}"
                        ItemsSource="{Binding LoraCollectionView}"
                        ItemTemplate="{StaticResource ComboBoxDataTemplateModel}"
                        HorizontalContentAlignment="Stretch"
                        IsSynchronizedWithCurrentItem="False"/>
                    <TextBlock Text="No models found." FontStyle="Italic" Opacity=".4" Margin="5,2,0,0" IsHitTestVisible="False" Visibility="{Binding LoraCollectionView.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>
            </DockPanel>


            <!--LoraAdapter2-->
            <DockPanel Visibility="{Binding LoraAdapters.Count, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=1, FallbackValue=Collapsed}">
                <UniformGrid Columns="1" DockPanel.Dock="Right" Width="20">
                    <Button Command="{Binding RemoveCommand}" CommandParameter="{Binding LoraAdapters[1]}">
                        <CommonControls:FontAwesome Icon="f00d" Size="9" Margin="0,1,0,0"/>
                    </Button>
                </UniformGrid>
                <Grid>
                    <ComboBox x:Name="ComboBoxLora1"
                        SelectedItem="{Binding LoraAdapters[1]}"
                        ItemsSource="{Binding LoraCollectionView}"
                        ItemTemplate="{StaticResource ComboBoxDataTemplateModel}"
                        HorizontalContentAlignment="Stretch"
                        IsSynchronizedWithCurrentItem="False"/>
                    <TextBlock Text="Please Select Lora..." FontStyle="Italic" Opacity=".4" Margin="5,3,0,0" IsHitTestVisible="False" Visibility="{Binding SelectedItem, ElementName=ComboBoxLora1, Converter={StaticResource InverseNullVisibilityConverter}}"/>
                </Grid>
            </DockPanel>


            <!--LoraAdapter3-->
            <DockPanel Visibility="{Binding LoraAdapters.Count, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=2, FallbackValue=Collapsed}">
                <UniformGrid Columns="1" DockPanel.Dock="Right" Width="20" >
                    <Button Command="{Binding RemoveCommand}" CommandParameter="{Binding LoraAdapters[2]}">
                        <CommonControls:FontAwesome Icon="f00d" Size="9" Margin="0,1,0,0"/>
                    </Button>
                </UniformGrid>
                <Grid>
                    <ComboBox x:Name="ComboBoxLora2"
                        SelectedItem="{Binding LoraAdapters[2]}"
                        ItemsSource="{Binding LoraCollectionView}"
                        ItemTemplate="{StaticResource ComboBoxDataTemplateModel}"
                        HorizontalContentAlignment="Stretch"
                        IsSynchronizedWithCurrentItem="False"/>
                    <TextBlock Text="Please Select Lora..." FontStyle="Italic" Opacity=".4" Margin="5,3,0,0" IsHitTestVisible="False" Visibility="{Binding SelectedItem, ElementName=ComboBoxLora2, Converter={StaticResource InverseNullVisibilityConverter}}"/>
                </Grid>
            </DockPanel>


            <!--LoraAdapter4-->
            <DockPanel Visibility="{Binding LoraAdapters.Count, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=3, FallbackValue=Collapsed}">
                <UniformGrid Columns="1" DockPanel.Dock="Right" Width="20" >
                    <Button Command="{Binding RemoveCommand}" CommandParameter="{Binding LoraAdapters[3]}">
                        <CommonControls:FontAwesome Icon="f00d" Size="9" Margin="0,1,0,0"/>
                    </Button>
                </UniformGrid>
                <Grid>
                    <ComboBox x:Name="ComboBoxLora3"
                        SelectedItem="{Binding LoraAdapters[3]}"
                        ItemsSource="{Binding LoraCollectionView}"
                        ItemTemplate="{StaticResource ComboBoxDataTemplateModel}"
                        HorizontalContentAlignment="Stretch"
                        IsSynchronizedWithCurrentItem="False"/>
                    <TextBlock Text="Please Select Lora..." FontStyle="Italic" Opacity=".4" Margin="5,3,0,0" IsHitTestVisible="False" Visibility="{Binding SelectedItem, ElementName=ComboBoxLora3, Converter={StaticResource InverseNullVisibilityConverter}}"/>
                </Grid>
            </DockPanel>


            <!--LoraAdapter5-->
            <DockPanel Visibility="{Binding LoraAdapters.Count, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=4, FallbackValue=Collapsed}">
                <UniformGrid Columns="1" DockPanel.Dock="Right" Width="20" >
                    <Button Command="{Binding RemoveCommand}" CommandParameter="{Binding LoraAdapters[4]}">
                        <CommonControls:FontAwesome Icon="f00d" Size="9" Margin="0,1,0,0"/>
                    </Button>
                </UniformGrid>
                <Grid>
                    <ComboBox x:Name="ComboBoxLora4"
                        SelectedItem="{Binding LoraAdapters[4]}"
                        ItemsSource="{Binding LoraCollectionView}"
                        ItemTemplate="{StaticResource ComboBoxDataTemplateModel}"
                        HorizontalContentAlignment="Stretch"
                        IsSynchronizedWithCurrentItem="False"/>
                    <TextBlock Text="Please Select Lora..." FontStyle="Italic" Opacity=".4" Margin="5,3,0,0" IsHitTestVisible="False" Visibility="{Binding SelectedItem, ElementName=ComboBoxLora4, Converter={StaticResource InverseNullVisibilityConverter}}"/>
                </Grid>
            </DockPanel>


            <!--LoraAdapter6-->
            <DockPanel Visibility="{Binding LoraAdapters.Count, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=5, FallbackValue=Collapsed}">
                <UniformGrid Columns="1" DockPanel.Dock="Right" Width="20" >
                    <Button Command="{Binding RemoveCommand}" CommandParameter="{Binding LoraAdapters[5]}">
                        <CommonControls:FontAwesome Icon="f00d" Size="9" Margin="0,1,0,0"/>
                    </Button>
                </UniformGrid>
                <Grid>
                    <ComboBox x:Name="ComboBoxLora5"
                        SelectedItem="{Binding LoraAdapters[5]}"
                        ItemsSource="{Binding LoraCollectionView}"
                        ItemTemplate="{StaticResource ComboBoxDataTemplateModel}"
                        HorizontalContentAlignment="Stretch"
                        IsSynchronizedWithCurrentItem="False"/>
                    <TextBlock Text="Please Select Lora..." FontStyle="Italic" Opacity=".4" Margin="5,3,0,0" IsHitTestVisible="False" Visibility="{Binding SelectedItem, ElementName=ComboBoxLora5, Converter={StaticResource InverseNullVisibilityConverter}}"/>
                </Grid>
            </DockPanel>
        </UniformGrid>

    </DockPanel>
</CommonControls:BaseControl>
