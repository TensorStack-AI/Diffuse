<CommonControls:BaseControl x:Class="Diffuse.Controls.DiffusionInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:base="clr-namespace:Diffuse"
             xmlns:local="clr-namespace:Diffuse.Controls"
             xmlns:Behaviors="clr-namespace:TensorStack.WPF.Behaviors;assembly=TensorStack.WPF"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             xmlns:CommonConverters="clr-namespace:TensorStack.WPF.Converters;assembly=TensorStack.WPF"
             xmlns:Controls="clr-namespace:Diffuse.Controls"
             xmlns:Common="clr-namespace:Diffuse.Common"
             xmlns:Views="clr-namespace:Diffuse.Views">
    <DockPanel  DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:DiffusionInputControl}}}">

        <TabControl DockPanel.Dock="Bottom" MinHeight="310">

            <!--Options-->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <CommonControls:FontAwesome Icon="f1de" IconStyle="Solid" Color="{StaticResource AccentColour2}"/>
                        <TextBlock Text="Options" Margin="5,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel Margin="0,4,0,0" >

                    <UniformGrid Columns="2">

                        <!--Presets-->
                        <StackPanel Margin="0,0,2,0" IsEnabled="False">
                            <TextBlock Text="Presets" Style="{StaticResource FieldTextBlockStyle}" />
                            <DockPanel>
                                <UniformGrid DockPanel.Dock="Right" Columns="2">
                                    <CommonControls:AddOnButton Icon="f00c" IconSize="12" IconColor="{StaticResource DefaultForeground}" Width="25" IconOpacity=".8"/>
                                    <CommonControls:AddOnButton Icon="f0c7" IconSize="13" IconColor="{StaticResource DefaultForeground}" Width="25" IconOpacity=".8" />
                                </UniformGrid>
                                <ComboBox />
                            </DockPanel>
                        </StackPanel>

                        <!--Resolution-->
                        <DockPanel Margin="2,0,0,0">
                            <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsResolutionEnabled}" Style="{StaticResource ToggleButtonBasic}" Width="25" Height="22" VerticalAlignment="Bottom">
                                <CommonControls:FontAwesome Icon="&#xf1ec;" IconStyle="Light" Size="12"/>
                            </ToggleButton>
                            <Grid>
                                <UniformGrid Columns="2" Visibility="{Binding IsResolutionEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                    <StackPanel Margin="0,0,1,0">
                                        <TextBlock Text="Width" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <TextBox Text="{Binding Options.Width, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Height" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <TextBox Text="{Binding Options.Height, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <StackPanel Visibility="{Binding IsResolutionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel.Resources>
                                        <CollectionViewSource x:Key="GroupedResolutions" Source="{Binding Pipeline.DiffusionModel.Resolutions}">
                                            <CollectionViewSource.GroupDescriptions>
                                                <PropertyGroupDescription PropertyName="Aspect"/>
                                            </CollectionViewSource.GroupDescriptions>
                                        </CollectionViewSource>
                                    </StackPanel.Resources>
                                    <TextBlock Text="Resolution" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <ComboBox ItemsSource="{Binding Source={StaticResource GroupedResolutions}}" SelectedItem="{Binding SelectedResolution}" IsSynchronizedWithCurrentItem="False" HorizontalContentAlignment="Stretch" SelectionChanged="ComboBoxResolution_SelectionChanged" >
                                        <ComboBox.ItemContainerStyle>
                                            <Style TargetType="{x:Type ComboBoxItem}" >
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ComboBox.ItemContainerStyle>
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding}" />
                                                    <TextBlock Margin="5,1,0,0" Text="{Binding Aspect}" Opacity=".7" FontSize="9" TextAlignment="Right" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                        <ComboBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="4,4,0,0" Text="{Binding Name}" FontSize="10" FontStyle="Italic" Opacity=".7"/>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ComboBox.GroupStyle>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </DockPanel>


                        <!--Seed-->
                        <DockPanel Margin="0,0,2,0">
                            <UniformGrid DockPanel.Dock="Right" Columns="2" VerticalAlignment="Bottom" Height="22">
                                <CommonControls:AddOnButton Icon="f051" IconSize="14" IconColor="{StaticResource DefaultForeground}" Width="25" IconOpacity=".8" Command="{Binding SeedCommand}" CommandParameter="{StaticResource False}" ToolTip="New Seed"/>
                                <CommonControls:AddOnButton Icon="f074" IconSize="14" IconColor="{StaticResource DefaultForeground}" Width="25" IconOpacity=".8" Command="{Binding SeedCommand}" CommandParameter="{StaticResource True}" ToolTip="Random Seeds"/>
                            </UniformGrid>
                            <StackPanel>
                                <TextBlock Text="Seed" Style="{StaticResource FieldTextBlockStyle}" />
                                <Grid>
                                    <TextBox x:Name="TextBoxSeed" Text="{Binding Options.Seed, UpdateSourceTrigger=PropertyChanged}" >
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Options.Seed}" Value="0"/>
                                                            <Condition Binding="{Binding IsFocused, ElementName=TextBoxSeed}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="Transparent"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <TextBlock Text="Random" IsHitTestVisible="False" Opacity=".8" Margin="4,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Options.Seed}" Value="0"/>
                                                            <Condition Binding="{Binding IsFocused, ElementName=TextBoxSeed}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </StackPanel>
                        </DockPanel>


                        <!--Scheduler-->
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="Scheduler" Style="{StaticResource FieldTextBlockStyle}" />
                            <ComboBox SelectedItem="{Binding Options.Scheduler}" ItemsSource="{Binding Pipeline.DiffusionModel.DefaultOptions.Schedulers}" Validation.ErrorTemplate="{x:Null}" SelectionChanged="ComboBoxScheduler_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                    </UniformGrid>

                    <!--ImageEdit-->
                    <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ImageEdit}">
                        <CommonControls:SliderControl Text="Input Images" Value="{Binding Options.InputImageCount}" Minimum="1" Maximum="4" TickFrequency="1" ValueFormat="N0" />
                    </StackPanel>

                    <!--Steps-->
                    <StackPanel Visibility="{Binding IsSteps2Enabled, Converter={StaticResource InverseBooleanToVisibilityConverter}, ConverterParameter=0}">
                        <CommonControls:SliderControl Text="Steps" Value="{Binding Options.Steps}" Minimum="1" Maximum="100" TickFrequency="1" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsSteps2Enabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <UniformGrid Columns="2">
                            <CommonControls:SliderControl Text="Steps (Stage1)" Value="{Binding Options.Steps}" Minimum="1" Maximum="100" TickFrequency="1" Margin="0,0,3,0"/>
                            <CommonControls:SliderControl Text="Steps (Stage2)" Value="{Binding Options.Steps2}" Minimum="1" Maximum="100" TickFrequency="1" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>


                    <!--GuidanceScale-->
                    <StackPanel Visibility="{Binding IsGuidance2Enabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <CommonControls:SliderControl Text="Guidance" Value="{Binding Options.GuidanceScale}" Minimum="1" Maximum="20" TickFrequency="0.1" ValueFormat="F2"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsGuidance2Enabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <UniformGrid Columns="2">
                            <CommonControls:SliderControl Text="Guidance (Model)" Value="{Binding Options.GuidanceScale2}" Minimum="1" Maximum="20" TickFrequency="0.1" ValueFormat="F2" Margin="0,0,3,0"/>
                            <CommonControls:SliderControl Text="Guidance (CFG)" Value="{Binding Options.GuidanceScale}" Minimum="1" Maximum="20" TickFrequency="0.1" ValueFormat="F2" Margin="3,0,0,0"/>
                        </UniformGrid>
                    </StackPanel>

                    <!--TextToImage-->
                    <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TextToImage}">
                    </StackPanel>

                    <!--ImageToImage-->
                    <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ImageToImage}">
                        <CommonControls:SliderControl Text="Strength" Value="{Binding Options.Strength}"  IsPercent="True"  Minimum="0.01" Maximum="1" TickFrequency="0.01"/>
                    </StackPanel>



                    <!--ControlNetImage-->
                    <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ControlNetImage}">
                        <CommonControls:SliderControl Text="ControlNet Strength" Value="{Binding Options.ControlNetStrength}" IsPercent="True" Minimum="0.01" Maximum="1" TickFrequency="0.01"/>
                    </StackPanel>

                    <!--ControlNetImageToImage-->
                    <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ControlNetImageToImage}">
                        <CommonControls:SliderControl Text="Strength" Value="{Binding Options.Strength}"  IsPercent="True"  Minimum="0.01" Maximum="1" TickFrequency="0.01"/>
                        <CommonControls:SliderControl Text="ControlNet Strength" Value="{Binding Options.ControlNetStrength}" IsPercent="True" Minimum="0.01" Maximum="1" TickFrequency="0.01"/>
                    </StackPanel>

                    <!--TextToVideo-->
                    <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=TextToVideo}">
                    </StackPanel>

                    <!--ImageToVideo-->
                    <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=ImageToVideo}">
                    </StackPanel>

                    <!--VideoToVideo-->
                    <StackPanel Visibility="{Binding ProcessType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=VideoToVideo}">
                    </StackPanel>

                    <!--LoraStrength-->
                    <UniformGrid Visibility="{Binding Pipeline.LoraAdapterModel, Converter={StaticResource NullVisibilityConverter}, FallbackValue=Collapsed}">
                        <Grid Visibility="{Binding Pipeline.LoraAdapterModel.Length, Converter={StaticResource GreaterOrEqualThanToVisibilityConverter}, ConverterParameter=1}">
                            <TextBlock Text="{Binding Pipeline.LoraAdapterModel[0].Name, StringFormat={}({0})}" FontSize="8" Margin="0,6,0,0" Opacity=".9" HorizontalAlignment="Center"/>
                            <CommonControls:SliderControl Text="Lora" Value="{Binding Options.LoraStrength[0]}" IsPercent="True" Minimum="0.01" Maximum="1" TickFrequency="0.01" />
                        </Grid>
                        <Grid Visibility="{Binding Pipeline.LoraAdapterModel.Length, Converter={StaticResource GreaterOrEqualThanToVisibilityConverter}, ConverterParameter=2}">
                            <TextBlock Text="{Binding Pipeline.LoraAdapterModel[1].Name, StringFormat={}({0})}" FontSize="8" Margin="0,6,0,0" Opacity=".9" HorizontalAlignment="Center"/>
                            <CommonControls:SliderControl Text="Lora" Value="{Binding Options.LoraStrength[1]}" IsPercent="True" Minimum="0.01" Maximum="1" TickFrequency="0.01" />
                        </Grid>
                        <Grid Visibility="{Binding Pipeline.LoraAdapterModel.Length, Converter={StaticResource GreaterOrEqualThanToVisibilityConverter}, ConverterParameter=3}">
                            <TextBlock Text="{Binding Pipeline.LoraAdapterModel[2].Name, StringFormat={}({0})}" FontSize="8" Margin="0,6,0,0" Opacity=".9" HorizontalAlignment="Center"/>
                            <CommonControls:SliderControl Text="Lora" Value="{Binding Options.LoraStrength[2]}" IsPercent="True" Minimum="0.01" Maximum="1" TickFrequency="0.01" />
                        </Grid>
                        <Grid Visibility="{Binding Pipeline.LoraAdapterModel.Length, Converter={StaticResource GreaterOrEqualThanToVisibilityConverter}, ConverterParameter=4}">
                            <TextBlock Text="{Binding Pipeline.LoraAdapterModel[3].Name, StringFormat={}({0})}" FontSize="8" Margin="0,6,0,0" Opacity=".9" HorizontalAlignment="Center"/>
                            <CommonControls:SliderControl Text="Lora" Value="{Binding Options.LoraStrength[3]}" IsPercent="True" Minimum="0.01" Maximum="1" TickFrequency="0.01" />
                        </Grid>
                        <Grid Visibility="{Binding Pipeline.LoraAdapterModel.Length, Converter={StaticResource GreaterOrEqualThanToVisibilityConverter}, ConverterParameter=5}">
                            <TextBlock Text="{Binding Pipeline.LoraAdapterModel[4].Name, StringFormat={}({0})}" FontSize="8" Margin="0,6,0,0" Opacity=".9" HorizontalAlignment="Center"/>
                            <CommonControls:SliderControl Text="Lora" Value="{Binding Options.LoraStrength[4]}" IsPercent="True" Minimum="0.01" Maximum="1" TickFrequency="0.01" />
                        </Grid>
                        <Grid Visibility="{Binding Pipeline.LoraAdapterModel.Length, Converter={StaticResource GreaterOrEqualThanToVisibilityConverter}, ConverterParameter=6}">
                            <TextBlock Text="{Binding Pipeline.LoraAdapterModel[5].Name, StringFormat={}({0})}" FontSize="8" Margin="0,6,0,0" Opacity=".9" HorizontalAlignment="Center"/>
                            <CommonControls:SliderControl Text="Lora" Value="{Binding Options.LoraStrength[5]}" IsPercent="True" Minimum="0.01" Maximum="1" TickFrequency="0.01" />
                        </Grid>
                        <UniformGrid.Style>
                            <Style TargetType="{x:Type UniformGrid}">
                                <Setter Property="Columns" Value="2"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Pipeline.LoraAdapterModel.Length}" Value="1">
                                        <Setter Property="Columns" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </UniformGrid.Style>
                    </UniformGrid>


                    <!--FlowMatch-->
                    <StackPanel Visibility="{Binding IsSchedulerFlowMatch, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <CommonControls:SliderControl Text="Shift" Value="{Binding Options.SchedulerOptions.Shift}"  Minimum="1" Maximum="10" TickFrequency="0.1" ValueFormat="F2"/>
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,6,0,0">
                            <Grid HorizontalAlignment="Left">
                                <CheckBox Content="Dynamic Shifting" IsChecked="{Binding Options.SchedulerOptions.UseDynamicShifting}" />
                            </Grid>
                            <Grid HorizontalAlignment="Right">
                                <CheckBox Content="Stochastic Sampling" IsChecked="{Binding Options.SchedulerOptions.StochasticSampling}" />
                            </Grid>
                        </UniformGrid>
                    </StackPanel>

                    <!--Karras-->
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding IsSchedulerKarras, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Grid>
                            <CheckBox Content="Karras Sigmas" IsChecked="{Binding Options.SchedulerOptions.UseKarrasSigmas}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </TabItem>


            <!--Advanced-->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <CommonControls:FontAwesome Icon="f085" IconStyle="Solid" Color="{StaticResource AccentColour2}"/>
                        <TextBlock Text="Advanced" Margin="5,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <StackPanel VerticalAlignment="Top">

                    <!--General-->
                    <UniformGrid Columns="3" Margin="0,4,0,0">
                        <StackPanel Margin="0,0,2,0">
                            <TextBlock Text="Scheduler" Style="{StaticResource FieldTextBlockStyle}" />
                            <ComboBox SelectedItem="{Binding Options.Scheduler}" ItemsSource="{Binding Pipeline.DiffusionModel.DefaultOptions.Schedulers}" Validation.ErrorTemplate="{x:Null}" SelectionChanged="ComboBoxScheduler_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ., Converter={StaticResource EnumDescriptionConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="Timesteps" Style="{StaticResource FieldTextBlockStyle}" />
                            <TextBox Text="{Binding Options.SchedulerOptions.NumTrainTimesteps, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Steps Offset" Style="{StaticResource FieldTextBlockStyle}" />
                            <TextBox Text="{Binding Options.SchedulerOptions.StepsOffset, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>


                    <!--IsSchedulerTimeStep-->
                    <UniformGrid  Columns="3" Visibility="{Binding IsSchedulerTimeStep, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                        <StackPanel Margin="0,0,2,0">
                            <TextBlock Text="Timestep Spacing" Style="{StaticResource FieldTextBlockStyle}" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource TimestepSpacingType}}" SelectedItem="{Binding Options.SchedulerOptions.TimestepSpacing}" />
                        </StackPanel>
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="Prediction" Style="{StaticResource FieldTextBlockStyle}" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource PredictionType}}" SelectedItem="{Binding Options.SchedulerOptions.PredictionType}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Variance" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:NullableComboBox ItemsSource="{Binding Source={StaticResource VarianceType}}" SelectedItem="{Binding Options.SchedulerOptions.VarianceType}" NullPrefix="None" />
                        </StackPanel>
                        <StackPanel Margin="0,0,2,0">
                            <TextBlock Text="Beta Schedule" Style="{StaticResource FieldTextBlockStyle}" />
                            <ComboBox ItemsSource="{Binding Source={StaticResource BetaScheduleType}}" SelectedItem="{Binding Options.SchedulerOptions.BetaSchedule}" />
                        </StackPanel>
                        <StackPanel Margin="2,0,0,0">
                            <TextBlock Text="Beta Start" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.BetaStart, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Beta End" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.BetaEnd, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>


                    <!--IsKarras-->
                    <UniformGrid  Columns="4" Visibility="{Binding IsSchedulerKarras, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0" >
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=CheckBoxKarras}" Margin="0,0,2,0">
                            <TextBlock Text="Rho" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.Rho, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=CheckBoxKarras}" Margin="2,0,0,0">
                            <TextBlock Text="Sigma Min" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.SigmaMin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=CheckBoxKarras}" Margin="4,0,0,0">
                            <TextBlock Text="Sigma Max" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.SigmaMax, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <CheckBox x:Name="CheckBoxKarras" Content="Karras" IsChecked="{Binding Options.SchedulerOptions.UseKarrasSigmas}" Margin="8,20,0,0"/>
                    </UniformGrid>


                    <!--IsSchedulerThresholding-->
                    <UniformGrid Columns="3" Visibility="{Binding IsSchedulerThresholding, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0" >
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=CheckBoxThresholding}" Margin="0,0,2,0">
                            <TextBlock Text="Thresholding Ratio" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.DynamicThresholdingRatio, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel>
                            <CheckBox x:Name="CheckBoxThresholding" Content="Thresholding" IsChecked="{Binding Options.SchedulerOptions.Thresholding}" Margin="8,20,0,0"/>
                        </StackPanel>
                    </UniformGrid>


                    <!--IsSchedulerClipSample-->
                    <UniformGrid Columns="3" Visibility="{Binding IsSchedulerClipSample, Converter={StaticResource BooleanToVisibilityConverter}}"  Margin="0,4,0,0">
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=CheckBoxClipSample}" Margin="0,0,2,0">
                            <TextBlock Text="Clip Range" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.ClipSampleRange, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel IsEnabled="{Binding IsChecked, ElementName=CheckBoxClipSample}" Margin="2,0,0,0">
                            <TextBlock Text="Sample Max" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.SampleMaxValue, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <CheckBox x:Name="CheckBoxClipSample" Content="Clip Sample" IsChecked="{Binding Options.SchedulerOptions.ClipSample}" Margin="8,20,0,0"/>
                        </StackPanel>
                    </UniformGrid>


                    <!--IsSchedulerMultiStep-->
                    <StackPanel Visibility="{Binding IsSchedulerMultiStep, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                        <UniformGrid  Columns="3" >
                            <StackPanel Margin="0,0,2,0">
                                <TextBlock Text="Solver" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding Source={StaticResource SolverType}}" SelectedItem="{Binding Options.SchedulerOptions.SolverType}" />
                            </StackPanel>
                            <StackPanel Margin="2,0,0,0">
                                <TextBlock Text="Algorithm" Style="{StaticResource FieldTextBlockStyle}" />
                                <ComboBox ItemsSource="{Binding Source={StaticResource AlgorithmType}}" SelectedItem="{Binding Options.SchedulerOptions.AlgorithmType}" />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Solver Order" Style="{StaticResource FieldTextBlockStyle}" />
                                <TextBox Text="{Binding Options.SchedulerOptions.SolverOrder, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,6,0,0">
                            <CheckBox Content="Lower Order Final" IsChecked="{Binding Options.SchedulerOptions.LowerOrderFinal}" />
                        </StackPanel>
                    </StackPanel>


                    <!--IsSchedulerFlowMatch-->
                    <StackPanel Visibility="{Binding IsSchedulerFlowMatch, Converter={StaticResource BooleanToVisibilityConverter}}"  Margin="0,4,0,0">
                        <UniformGrid  Columns="3" >
                            <StackPanel Margin="0,0,2,0">
                                <TextBlock Text="Shift" Style="{StaticResource FieldTextBlockStyle}" />
                                <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.Shift, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="2,0,0,0">
                                <TextBlock Text="Base Shift" Style="{StaticResource FieldTextBlockStyle}" />
                                <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.BaseShift, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Max Shift" Style="{StaticResource FieldTextBlockStyle}" />
                                <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.MaxShift, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <Grid HorizontalAlignment="Left">
                                <CheckBox Content="Dynamic Shifting" IsChecked="{Binding Options.SchedulerOptions.UseDynamicShifting}" />
                            </Grid>
                            <Grid HorizontalAlignment="Right">
                                <CheckBox Content="Stochastic Sampling" IsChecked="{Binding Options.SchedulerOptions.StochasticSampling}" />
                            </Grid>
                        </UniformGrid>
                    </StackPanel>



                    <!--IsStochastic-->
                    <UniformGrid  Columns="5" Visibility="{Binding IsSchedulerStochastic, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Eta" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.Eta, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Noise" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.SNoise, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Churn" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.SChurn, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Min" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.STmin, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="Max" Style="{StaticResource FieldTextBlockStyle}" />
                            <CommonControls:FloatBox FloatValue="{Binding Options.SchedulerOptions.STmax, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>


                </StackPanel>

            </TabItem>


            <!--Models-->
            <TabItem Visibility="{Binding IsModelOptionsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <CommonControls:FontAwesome Icon="e4e2" IconStyle="Solid" Color="{StaticResource AccentColour2}"/>
                        <TextBlock Text="Models" Margin="5,0,0,0"/>
                    </StackPanel>
                </TabItem.Header>

                <UniformGrid Columns="1" Margin="0,4,0,0" >

                    <!--UpscaleOptions-->
                    <GroupBox Header="Upscale Options" Margin="0,0,0,6" Visibility="{Binding Pipeline.UpscaleModel, Converter={StaticResource NullVisibilityConverter}, FallbackValue=Collapsed}">
                        <Controls:UpscaleInputControl Pipeline="{Binding Pipeline, Mode=OneWay}" Options="{Binding UpscaleOptions, Mode=OneWayToSource}" />
                    </GroupBox>

                    <!--ExtractOptions-->
                    <GroupBox Header="Extract Options" Margin="0,0,0,6" Visibility="{Binding Pipeline.ExtractModel, Converter={StaticResource NullVisibilityConverter}, FallbackValue=Collapsed}">
                        <Controls:ExtractInputControl Pipeline="{Binding Pipeline, Mode=OneWay}" Options="{Binding ExtractOptions, Mode=OneWayToSource}" />
                    </GroupBox>

                </UniformGrid>
            </TabItem>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <UniformGrid IsItemsHost="True" Rows="1" DockPanel.Dock="Top"></UniformGrid>
                        <ContentPresenter ContentSource="SelectedContent"></ContentPresenter>
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
        </TabControl>




        <!--Prompt-->
        <DockPanel Margin="0,4,0,10">

            <!--LoRA Triggers-->
            <DockPanel DockPanel.Dock="Bottom" >
                <ItemsControl ItemsSource="{Binding Pipeline.LoraAdapterModel}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ListBox ItemsSource="{Binding Triggers}" ItemContainerStyle="{StaticResource TransparentListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel IsItemsHost="True" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Command="{Binding AddTriggerWordCommand, RelativeSource={RelativeSource AncestorType={x:Type local:DiffusionInputControl}}}" CommandParameter="{Binding}" Background="{StaticResource ButtonBackgroundDisabled}" FontSize="9" Margin="0,2,3,0" Padding="3,0" ToolTip="Add LoRA Trigger word"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!--Prompts-->
            <UniformGrid Columns="1" >
                <DockPanel>
                    <TextBlock  DockPanel.Dock="Top" Text="Prompt" Style="{StaticResource FieldTextBlockStyle}" />
                    <TextBox  Text="{Binding Options.Prompt}" TextWrapping="Wrap" AcceptsReturn="True" />
                </DockPanel>
                <DockPanel x:Name="PanelNegativePrompt" Visibility="{Binding Options.GuidanceScale, Converter={StaticResource GreaterThanToVisibilityConverter}, ConverterParameter=1, FallbackValue=Collapsed}">
                    <TextBlock DockPanel.Dock="Top" Text="Negative Prompt" Style="{StaticResource FieldTextBlockStyle}" />
                    <TextBox Text="{Binding Options.NegativePrompt, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" />
                </DockPanel>
                <UniformGrid.Style>
                    <Style TargetType="{x:Type UniformGrid}">
                        <Setter Property="Rows" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Visibility, ElementName=PanelNegativePrompt}" Value="Visible">
                                <Setter Property="Rows" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>
            </UniformGrid>
        </DockPanel>

    </DockPanel>
</CommonControls:BaseControl>
