<CommonControls:BaseControl x:Class="Diffuse.Controls.UpscaleInputControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Diffuse.Controls"
             xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
             Name="UpscaleInputUI" >
    <StackPanel DataContext="{Binding ElementName=UpscaleInputUI}">
        <UniformGrid Columns="3">
            <StackPanel>
                <TextBlock Text="Tile Mode" Style="{StaticResource FieldTextBlockStyle}" />
                <ComboBox SelectedItem="{Binding Options.TileMode}" ItemsSource="{Binding Source={StaticResource TileMode}}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Tile Size" Style="{StaticResource FieldTextBlockStyle}" />
                <TextBox Text="{Binding Options.TileSize}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Tile Overlap" Style="{StaticResource FieldTextBlockStyle}" />
                <TextBox Text="{Binding Options.TileOverlap}" />
            </StackPanel>
        </UniformGrid>
    </StackPanel>
</CommonControls:BaseControl>
