<Window x:Class="Diffuse.Splashscreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Diffuse"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        Height="300"
        Width="400"
        Background="Transparent" 
        Foreground="#FFC8C8C8"
        WindowStartupLocation="CenterScreen" 
        Icon="/Images/Icon.ico"
        Cursor="AppStarting" 
        Focusable="False"
        IsHitTestVisible="False"
        IsTabStop="False">
    <Border UseLayoutRounding="True" Background="#FF272727" BorderBrush="#80c5a343" BorderThickness="1">
        <Grid>
            <StackPanel VerticalAlignment="Center" Width="240">
                <Image Source="/Images/Diffuse-Logo-512.png" />
            </StackPanel>
            <TextBlock Text="{x:Static local:App.AppDisplayName}" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,4"/>
        </Grid>
    
    </Border>
</Window>
