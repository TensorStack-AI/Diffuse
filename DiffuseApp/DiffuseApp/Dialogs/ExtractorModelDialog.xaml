<CommonControls:DialogControl x:Class="Diffuse.Dialogs.ExtractorModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diffuse.Dialogs"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        mc:Ignorable="d"
        MinWidth="600"
        MaxWidth="600"
        Title="Extractor"
        Icon="{StaticResource ImageIcon}"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ExtractorModelDialog}}}" Margin="15, 15, 15, 10">

        <!--Model Settings-->
        <UniformGrid DockPanel.Dock="Top" Columns="3">
            <StackPanel>
                <TextBlock Text="Name" Style="{StaticResource FieldTextBlockStyle}"/>
                <TextBox Text="{Binding ExtractorModel.Name, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Margin="1,0,0,0" >
                <TextBlock Text="Type" Style="{StaticResource FieldTextBlockStyle}"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource ExtractorType}}" SelectedItem="{Binding ExtractorModel.Type}" SelectedIndex="0" />
            </StackPanel>
            <CheckBox DockPanel.Dock="Right" Content="Default" IsChecked="{Binding ExtractorModel.IsDefault}" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
        </UniformGrid>

        <!--Model Settings-->
        <UniformGrid DockPanel.Dock="Top" Columns="3">
            <StackPanel Margin="0,0,1,0">
                <TextBlock Text="Scale Factor" Style="{StaticResource FieldTextBlockStyle}"/>
                <TextBox Text="{Binding ExtractorModel.Type, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="1,0,0,0">
                <TextBlock Text="Sample Size" Style="{StaticResource FieldTextBlockStyle}"/>
                <TextBox Text="{Binding ExtractorModel.SampleSize, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="1,0,0,0">
                <TextBlock Text="Output Channels" Style="{StaticResource FieldTextBlockStyle}"/>
                <TextBox Text="{Binding ExtractorModel.OutputChannels, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <StackPanel Margin="0,0,1,0">
                <TextBlock Text="Input Normalization" Style="{StaticResource FieldTextBlockStyle}"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource NormalizationType}}" SelectedItem="{Binding ExtractorModel.Normalization}" SelectedIndex="0" />
            </StackPanel>
            <StackPanel Margin="1,0,0,0">
                <TextBlock Text="Output Normalization" Style="{StaticResource FieldTextBlockStyle}"/>
                <ComboBox ItemsSource="{Binding Source={StaticResource NormalizationType}}" SelectedItem="{Binding ExtractorModel.OutputNormalization}" SelectedIndex="0" />
            </StackPanel>
            <CheckBox DockPanel.Dock="Right" Content="Dynamic Output Shape" IsChecked="{Binding ExtractorModel.IsDynamicOutput}" VerticalAlignment="Bottom" Margin="10,0,0,2"/>
        </UniformGrid>


        <!--Save/Cancel/Errors-->
        <DockPanel DockPanel.Dock="Bottom" Height="30" Margin="0,15,0,0">
            <UniformGrid DockPanel.Dock="Right" Columns="2" >
                <Button Content="Save" Command="{Binding SaveCommand}" Width="100" IsDefault="True"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="IndianRed" TextWrapping="Wrap" FontSize="11"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>


        <!--Files-->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Command="{Binding AddFileCommand}" Height="22" Width="40" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                    <CommonControls:FontAwesome Icon="2b" IconStyle="Light" Color="{StaticResource SuccessColour}"/>
                </Button>
                <StackPanel Margin="0,3,3,0">
                    <TextBlock Text="Model Urls" Style="{StaticResource FieldTextBlockStyle}"/>
                    <TextBox Text="{Binding SelectedFile, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </DockPanel>
            <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" ItemContainerStyle="{StaticResource TransparentListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,3,0,0" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource ButtonBackgroundDisabled}" Margin="2">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding RemoveFileCommand, RelativeSource={RelativeSource AncestorType={x:Type local:ExtractorModelDialog}}}" CommandParameter="{Binding}" Style="{StaticResource TransparentButton}">
                                    <CommonControls:FontAwesome Icon="f00d" Color="{StaticResource DangerColour}" />
                                </Button>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,2,0">
                                    <TextBlock Text="{Binding}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

    </DockPanel>
</CommonControls:DialogControl>