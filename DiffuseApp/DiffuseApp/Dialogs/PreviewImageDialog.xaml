<CommonControls:DialogControl x:Class="Diffuse.Dialogs.PreviewImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Diffuse.Dialogs"
        xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
        Title="View Image"
        SizeToContent="Manual"
        WindowStartupLocation="CenterOwner"
        Icon="{StaticResource ImageIcon}"
        Style="{StaticResource {x:Type CommonControls:DialogControl}}">
    <DockPanel DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:PreviewImageDialog}}}" Margin="15, 15, 15, 10">


        <Grid DockPanel.Dock="Bottom" Height="30"  Margin="0,20,0,0">
            <UniformGrid Columns="2" HorizontalAlignment="Left">
                <Button Content="Prev" Command="{Binding PrevCommand}" Width="100"/>
                <Button Content="Next" Command="{Binding NextCommand}" Width="100"/>
            </UniformGrid>
            <Button HorizontalAlignment="Right" Content="Close" Command="{Binding CancelCommand}" Width="100" IsDefault="True"/>
        </Grid>


        <CommonControls:ImageElement Source="{Binding CurrentImage}" IsLoadEnabled="False" IsLoadOverlayEnabled="False" IsSaveOverlayEnabled="False" IsRemoveEnabled="False"/>

    </DockPanel>
</CommonControls:DialogControl>