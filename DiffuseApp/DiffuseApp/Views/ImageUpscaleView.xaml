<Views:ViewBase x:Class="Diffuse.Views.ImageUpscaleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Diffuse.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Diffuse.Controls"
    xmlns:Views="clr-namespace:Diffuse.Views">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ImageUpscaleView}}}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="360"/>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>


            <!--***Left Panel***-->
            <Grid Grid.Column="0">
                <Border Margin="4">
                    <DockPanel x:Name="LeftPanelContainer" Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}}">

                        <StackPanel DockPanel.Dock="Top" IsEnabled="{Binding UpscaleService.IsLoading, Converter={StaticResource InverseBoolConverter}}">

                            <!--ModelControl-->
                            <StackPanel DockPanel.Dock="Top" >
                                <Grid IsEnabled="{Binding UpscaleService.IsExecuting, Converter={StaticResource InverseBoolConverter}}">
                                    <Controls:ModelControl
                                        IsUpscalerEnabled="True"
                                        Settings="{Binding Settings, Mode=OneWay}" 
                                        CurrentPipeline="{Binding CurrentPipeline, Mode=TwoWay}"
                                        SelectionChanged="SelectedUpscalerChanged"/>
                                </Grid>
                            </StackPanel>

                        </StackPanel>

                        <!--Execute/Cancel-->
                        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Height="30">
                            <Button Content="Cancel" Command="{Binding CancelCommand}" />
                            <Button Content="Upscale" Command="{Binding ExecuteCommand}" />
                        </UniformGrid>


                        <StackPanel IsEnabled="{Binding UpscaleService.IsLoaded}">

                            <!--Input Image-->
                            <Border Margin="0,15,0,15"
                                VerticalAlignment="Top"
                                Style="{StaticResource ImageDropZoneStyle}"
                                Width="{Binding ActualWidth,ElementName=LeftPanelContainer}"
                                Height="{Binding ActualWidth,ElementName=LeftPanelContainer}"
                                MaxHeight="{Binding ActualWidth,ElementName=LeftPanelContainer}">
                                <CommonControls:ImageElement
                                    Source="{Binding SourceImage, Mode=TwoWay}"
                                    IsLoadEnabled="True"
                                    IsLoadOverlayEnabled="False" 
                                    IsSaveEnabled="False" />
                            </Border>

                            <!--Options-->
                            <Controls:UpscaleInputControl Options="{Binding Options}" />

                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>


            <!--GridSplitter-->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" Opacity=".4" Margin="0,20" />


            <!--***Right Panel***-->
            <Grid Grid.Column="2" Grid.Row="0" >

                <!--Content-->
                <DockPanel>

                    <!--Statistics-->
                    <Controls:StatisticsControl 
                        DockPanel.Dock="Bottom"
                        Margin="14,0,14,8"
                        Statistics="{Binding Statistics}"
                        Progress="{Binding Progress}" />

                    <Border Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}}">
                        <Grid Margin="10,10,10,2" >
                            <CommonControls:ImageElement 
                                SplitterVisibility="Auto"
                                SplitterPosition="Source"
                                SplitterDirection="LeftToRight"
                                Source="{Binding ResultImage, Mode=TwoWay}" 
                                OverlaySource="{Binding CompareImage, Mode=TwoWay}" 
                                IsLoadEnabled="False" 
                                IsLoadOverlayEnabled="False"/>
                        </Grid>
                    </Border>
                </DockPanel>

            </Grid>
        </Grid>

    </Grid>
</Views:ViewBase>
