<Views:ViewBase x:Class="Diffuse.Views.ControlNetImageToImageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Diffuse.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Diffuse.Controls"
    xmlns:Views="clr-namespace:Diffuse.Views">
    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:ControlNetImageToImageView}}}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="360"/>
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>


            <!--***Left Panel***-->
            <Grid Grid.Column="0">
                <Border Margin="4">
                    <DockPanel x:Name="LeftPanelContainer" Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}}">

                        <!--ModelControl-->
                        <StackPanel DockPanel.Dock="Top" IsEnabled="{Binding DiffusionService.IsLoading, Converter={StaticResource InverseBoolConverter}}">
                            <Grid IsEnabled="{Binding DiffusionService.IsExecuting, Converter={StaticResource InverseBoolConverter}}">
                                <Controls:DiffusionModelControl
                                    x:Name="ModelControl"
                                    ProcessType="ControlNetImageToImage"
                                    IsLoraSupported="True"
                                    IsUpscalerSupported="True"
                                    IsExtractorSupported="True"
                                    IsControlNetSupported="True"
                                    Settings="{Binding Settings, Mode=OneWay}" 
                                    CurrentPipeline="{Binding CurrentPipeline, Mode=TwoWay}"
                                    SelectionChanged="SelectedPipelineChanged"/>
                            </Grid>
                        </StackPanel>

                        <DockPanel DockPanel.Dock="Bottom" >

                            <!--Execute/Cancel-->
                            <UniformGrid DockPanel.Dock="Bottom" Columns="2" Height="30" >
                                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                                <Grid IsEnabled="{Binding IsSelectionValid, ElementName=ModelControl}">
                                    <Button Content="Generate" Command="{Binding ExecuteCommand}" />
                                </Grid>
                            </UniformGrid>

                            <!--InputControl-->
                            <Grid IsEnabled="{Binding DiffusionService.IsLoaded}">
                                <Controls:DiffusionInputControl 
                                    ProcessType="ControlNetImageToImage"
                                    Options="{Binding Options, Mode=OneWayToSource}"
                                    UpscaleOptions="{Binding UpscaleOptions, Mode=OneWayToSource}"
                                    ExtractOptions="{Binding ExtractOptions, Mode=OneWayToSource}"
                                    Pipeline="{Binding CurrentPipeline}" 
                                    IsImageInputEnabled="True"
                                    IsControlNetEnabled="False"
                                    IsEnabled="{Binding CurrentPipeline, Converter={StaticResource InverseNullBooleanConverter}}"/>
                            </Grid>

                        </DockPanel>
                    </DockPanel>
                </Border>
            </Grid>


            <!--GridSplitter-->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Width="5" Opacity=".4" Margin="0,20" />


            <!--***Right Panel***-->
            <Grid Grid.Column="2" Grid.Row="0" >

                <!--Content-->
                <DockPanel>

                    <!--Statistics-->
                    <Controls:StatisticsControl 
                        DockPanel.Dock="Bottom"
                        Margin="14,0,14,8"
                        Statistics="{Binding Statistics}"
                        Progress="{Binding Progress}" />

                    <Border Margin="4" IsEnabled="{Binding IsViewBusy, Converter={StaticResource InverseBoolConverter}}">
                        <UniformGrid Columns="2">
                            <UniformGrid Columns="1" Rows="2" Margin="10,10,10,2" IsEnabled="{Binding DiffusionService.IsLoaded}">
                                <Border  Style="{StaticResource ImageDropZoneStyle}" Margin="0,0,0,4">
                                    <CommonControls:ImageElement 
                                        CropWidth="{Binding Options.Width}"
                                        CropHeight="{Binding Options.Height}"
                                        SplitterVisibility="Auto"
                                        SplitterPosition="Source"
                                        SplitterDirection="LeftToRight"
                                        Source="{Binding SourceImage1, Mode=TwoWay}" 
                                        IsLoadEnabled="True" 
                                        IsSaveEnabled="False"
                                        IsLoadOverlayEnabled="False"
                                        SourceChanged="SourceImage1_SourceChanged"
                                        IsEnabled="{Binding DiffusionService.IsExecuting, Converter={StaticResource InverseBoolConverter}}"/>
                                </Border>
                                <Border Style="{StaticResource ImageDropZoneStyle}" IsEnabled="{Binding ExtractService.IsLoaded, Converter={StaticResource InverseBoolConverter}}" Margin="0,4,0,0">
                                    <CommonControls:ImageElement 
                                        CropWidth="{Binding Options.Width}"
                                        CropHeight="{Binding Options.Height}"
                                        SplitterVisibility="Auto"
                                        SplitterPosition="Source"
                                        SplitterDirection="LeftToRight"
                                        Source="{Binding SourceImage2, Mode=TwoWay}" 
                                        IsLoadEnabled="True" 
                                        IsSaveEnabled="False"
                                        IsLoadOverlayEnabled="False"
                                        IsEnabled="{Binding DiffusionService.IsExecuting, Converter={StaticResource InverseBoolConverter}}"/>
                                </Border>
                            </UniformGrid>
                        
                            <Grid Margin="10,10,10,2" >
                                <CommonControls:ImageElement 
                                    SplitterVisibility="Auto"
                                    SplitterPosition="Source"
                                    SplitterDirection="LeftToRight"
                                    Source="{Binding ResultImage, Mode=TwoWay}" 
                                    OverlaySource="{Binding CompareImage, Mode=TwoWay}" 
                                    IsLoadEnabled="False" 
                                    IsLoadOverlayEnabled="False"/>
                            </Grid>
                        </UniformGrid>
                    </Border>
                </DockPanel>

            </Grid>
        </Grid>

    </Grid>
</Views:ViewBase>
