<Views:ViewBase x:Class="Diffuse.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Diffuse.Views"
    xmlns:CommonControls="clr-namespace:TensorStack.WPF.Controls;assembly=TensorStack.WPF"
    xmlns:Controls="clr-namespace:Diffuse.Controls"
    xmlns:Views="clr-namespace:Diffuse.Views">

    <Views:ViewBase.Resources>

        <Style x:Key="SettingsListBoxItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{StaticResource ControlBrightDefaultBorderBrush }" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Border Name="Border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger  Property="IsSelected" Value="True" >
                    <Setter Property="Background" Value="{StaticResource ControlMouseOverBackground}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentColour2}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Views:ViewBase.Resources>

    <Grid DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type local:SettingsView}}}" >
        <TabControl TabStripPlacement="Left"  Style="{StaticResource LeftTabControl}" Margin="40" SelectedIndex="0">


            <!--General-->
            <TabItem DockPanel.Dock="Top" Margin="0,6,0,0">
                <TabItem.Header>
                    <DockPanel Width="200" Height="35" >
                        <TextBlock Text="General" TextAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>
                </TabItem.Header>

                <UniformGrid Columns="2">
                    <DockPanel VerticalAlignment="Top" Margin="10,0">
                        <Button DockPanel.Dock="Bottom" Command="{Binding SaveCommand}" Width="120" Height="30" HorizontalAlignment="Right" Margin="0,10,0,0" >
                            <StackPanel Orientation="Horizontal">
                                <CommonControls:FontAwesome Icon="f0c7" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                                <TextBlock Text="Save Changes" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <UniformGrid Columns="1">
                            <StackPanel>
                                <TextBlock Text="Model Directory" Style="{StaticResource FieldTextBlockStyle}"/>
                                <CommonControls:FilePickerTextBox  FileName="{Binding Settings.DirectoryModel}" IsFolderPicker="True" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Temp Directory" Style="{StaticResource FieldTextBlockStyle}"/>
                                <CommonControls:FilePickerTextBox  FileName="{Binding Settings.DirectoryTemp}" IsFolderPicker="True" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Huggingface Model Cache" Style="{StaticResource FieldTextBlockStyle}"/>
                                <CommonControls:FilePickerTextBox  FileName="{Binding Settings.DirectoryCache, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsFolderPicker="True" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Huggingface Secure Token" Style="{StaticResource FieldTextBlockStyle}"/>
                                <TextBox  Text="{Binding Settings.SecureToken}" />
                            </StackPanel>
                         
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" Width="120">
                                    <TextBlock Text="Max History" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <TextBox  Text="{Binding Settings.MaxHistory}"  />
                                </StackPanel>
                                <StackPanel >
                                    <TextBlock Text="History Directory" Style="{StaticResource FieldTextBlockStyle}"/>
                                    <CommonControls:FilePickerTextBox  FileName="{Binding Settings.DirectoryHistory}" IsFolderPicker="True" />
                                </StackPanel>
                            </DockPanel>
                        </UniformGrid>
                    </DockPanel>
                </UniformGrid>
            </TabItem>


            <!--Environment Models-->
            <TabItem DockPanel.Dock="Top">
                <TabItem.Header>
                    <DockPanel Width="200" Height="35" >
                        <TextBlock Text="Environments" TextAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>
                </TabItem.Header>
                <Grid Margin="10,0, 5, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <!--Environments-->
                    <DockPanel Grid.Column="0" >
                        <TextBlock DockPanel.Dock="Top" Text="Environments" Style="{StaticResource FieldTextBlockStyle}" />
                        <UniformGrid DockPanel.Dock="Bottom" Columns="4" Height="30">
                            <Button Command="{Binding AddEnvironmentCommand}" ToolTip="Add Environment">
                                <CommonControls:FontAwesome Icon="2b" IconStyle="Light" Color="{StaticResource SuccessColour}"/>
                            </Button>
                            <Button Command="{Binding UpdateEnvironmentCommand}" ToolTip="Update Environment">
                                <CommonControls:FontAwesome Icon="f0ad" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                            <Button Command="{Binding RemoveEnvironmentCommand}" ToolTip="Remove Environment">
                                <CommonControls:FontAwesome Icon="f2ed" IconStyle="Light" Color="{StaticResource DangerColour}"/>
                            </Button>
                            <Button Command="{Binding CopyEnvironmentCommand}" ToolTip="Copy Environment">
                                <CommonControls:FontAwesome Icon="f24d" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding Settings.Environments}" SelectedItem="{Binding SelectedEnvironment}" ItemContainerStyle="{StaticResource SettingsListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel DockPanel.Dock="Left">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="12" Margin="3,0,0,0" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Pipeline}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                            <TextBlock Text="{Binding Vendor}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                    <DockPanel Grid.Column="1"  Margin="10, 0,0,0">
                        <DockPanel DockPanel.Dock="Top">

                            <!--Actions-->
                            <DockPanel DockPanel.Dock="Right"  >
                                <TextBlock DockPanel.Dock="Top" Text="Actions" Style="{StaticResource FieldTextBlockStyle}" />
                                <UniformGrid  Columns="2" VerticalAlignment="Top" Width="200">
                                    <Button Content="Create" Command="{Binding EnvironmentServiceCreateCommand}" Height="32"/>
                                    <Button Content="Update" Command="{Binding EnvironmentServiceUpdateCommand}"/>
                                    <Button Content="Rebuild" Command="{Binding EnvironmentServiceRebuildCommand}"/>
                                    <Button Content="Delete" Command="{Binding EnvironmentServiceDeleteCommand}"/>
                                </UniformGrid>
                            </DockPanel>

                            <!--Environment-->
                            <UniformGrid Columns="3" Margin="0,0,100,0">
                                <StackPanel Margin="0,0,2,0">
                                    <TextBlock Text="Name" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBox Text="{Binding SelectedEnvironment.Name}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,2,0">
                                    <TextBlock Text="Environment" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBox Text="{Binding SelectedEnvironment.Environment}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,0,0">
                                    <CheckBox Content="Default" IsChecked="{Binding SelectedEnvironment.IsDefault}" Margin="10,18,0,2" IsHitTestVisible="False"/>
                                </StackPanel>

                                <StackPanel Margin="2,0,2,0">
                                    <TextBlock Text="Vendor" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBox Text="{Binding SelectedEnvironment.Vendor}" IsReadOnly="True"/>
                                </StackPanel>
                                <StackPanel Margin="2,0,2,0">
                                    <TextBlock Text="Type" Style="{StaticResource FieldTextBlockStyle}" />
                                    <TextBox Text="{Binding SelectedEnvironment.Type}" IsReadOnly="True"/>
                                </StackPanel>
                                <Grid Margin="2,0,0,0" IsHitTestVisible="False">
                                    <StackPanel Visibility="{Binding  SelectedEnvironment.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Device}">
                                        <TextBlock Text="Device" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <ComboBox ItemsSource="{Binding Settings.Devices}" SelectedItem="{Binding SelectedEnvironment.Device}" DisplayMemberPath="Name" SelectedValuePath="HardwareID" SelectedIndex="0"/>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding  SelectedEnvironment.Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Pipeline}">
                                        <TextBlock Text="Pipeline" Style="{StaticResource FieldTextBlockStyle}"/>
                                        <TextBox Text="{Binding SelectedEnvironment.Pipeline}" IsReadOnly="True" />
                                    </StackPanel>
                                </Grid>
                            </UniformGrid>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock Text="Environment Variables" Style="{StaticResource FieldTextBlockStyle}" />
                            <ListBox ItemsSource="{Binding SelectedEnvironment.Variables}"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" MinHeight="100"/>
                        </StackPanel>
                        <DockPanel>
                            <TextBlock  DockPanel.Dock="Top" Text="Requirements" Style="{StaticResource FieldTextBlockStyle}" />
                            <ListBox ItemsSource="{Binding SelectedEnvironment.Requirements}"  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        </DockPanel>
                    </DockPanel>
                </Grid>
            </TabItem>


            <!--Diffusion Models-->
            <TabItem DockPanel.Dock="Top">
                <TabItem.Header>
                    <DockPanel Width="200" Height="35" >
                        <TextBlock Text="Diffusion Models" TextAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>
                </TabItem.Header>

                <UniformGrid Columns="3">

                    <!--Diffusion-->
                    <DockPanel Margin="10,0, 5, 0">
                        <TextBlock DockPanel.Dock="Top" Text="Diffusion Models" Style="{StaticResource FieldTextBlockStyle}" />
                        <UniformGrid DockPanel.Dock="Bottom" Columns="4" Height="30">
                            <Button Command="{Binding AddDiffusionModelCommand}" ToolTip="Add New Model">
                                <CommonControls:FontAwesome Icon="2b" IconStyle="Light" Color="{StaticResource SuccessColour}"/>
                            </Button>
                            <Button Command="{Binding UpdateDiffusionModelCommand}" ToolTip="Update Model">
                                <CommonControls:FontAwesome Icon="f0ad" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                            <Button Command="{Binding RemoveDiffusionModelCommand}" ToolTip="Remove Model">
                                <CommonControls:FontAwesome Icon="f2ed" IconStyle="Light" Color="{StaticResource DangerColour}"/>
                            </Button>
                            <Button Command="{Binding CopyDiffusionModelCommand}" ToolTip="Copy Model">
                                <CommonControls:FontAwesome Icon="f24d" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding Settings.DiffusionModels}" SelectedItem="{Binding SelectedDiffusionModel}" ItemContainerStyle="{StaticResource SettingsListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel DockPanel.Dock="Left">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="12" Margin="3,0,0,0" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Pipeline}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                            <TextBlock Text="{Binding Path}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!--LoRA-->
                    <DockPanel Margin="5,0">
                        <TextBlock DockPanel.Dock="Top" Text="LoRA Models" Style="{StaticResource FieldTextBlockStyle}" />
                        <UniformGrid DockPanel.Dock="Bottom" Columns="4" Height="30">
                            <Button Command="{Binding AddLoraModelCommand}" ToolTip="Add New Model">
                                <CommonControls:FontAwesome Icon="2b" IconStyle="Light" Color="{StaticResource SuccessColour}"/>
                            </Button>
                            <Button Command="{Binding UpdateLoraModelCommand}" ToolTip="Update Model">
                                <CommonControls:FontAwesome Icon="f0ad" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                            <Button Command="{Binding RemoveLoraModelCommand}" ToolTip="Remove Model">
                                <CommonControls:FontAwesome Icon="f2ed" IconStyle="Light" Color="{StaticResource DangerColour}"/>
                            </Button>
                            <Button Command="{Binding CopyLoraModelCommand}" ToolTip="Copy Model">
                                <CommonControls:FontAwesome Icon="f24d" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding Settings.LoraAdapterModels}" SelectedItem="{Binding SelectedLoraModel}" ItemContainerStyle="{StaticResource SettingsListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel DockPanel.Dock="Left">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="12" Margin="3,0,0,0" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Pipeline}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                            <TextBlock Text="{Binding Path}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <!--ControlNet-->
                    <DockPanel Margin="5,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="ControlNet Models" Style="{StaticResource FieldTextBlockStyle}" />
                        <UniformGrid DockPanel.Dock="Bottom" Columns="4" Height="30">
                            <Button Command="{Binding AddControlNetModelCommand}" ToolTip="Add New Model">
                                <CommonControls:FontAwesome Icon="2b" IconStyle="Light" Color="{StaticResource SuccessColour}"/>
                            </Button>
                            <Button Command="{Binding UpdateControlNetModelCommand}" ToolTip="Update Model">
                                <CommonControls:FontAwesome Icon="f0ad" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                            <Button Command="{Binding RemoveControlNetModelCommand}" ToolTip="Remove Model">
                                <CommonControls:FontAwesome Icon="f2ed" IconStyle="Light" Color="{StaticResource DangerColour}"/>
                            </Button>
                            <Button Command="{Binding CopyControlNetModelCommand}" ToolTip="Copy Model">
                                <CommonControls:FontAwesome Icon="f24d" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding Settings.ControlNetModels}" SelectedItem="{Binding SelectedControlNetModel}" ItemContainerStyle="{StaticResource SettingsListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel DockPanel.Dock="Left">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="12" Margin="3,0,0,0" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Pipeline}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                            <TextBlock Text="{Binding Path}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>


                </UniformGrid>
            </TabItem>


            <!--Extract Models-->
            <TabItem DockPanel.Dock="Top">
                <TabItem.Header>
                    <DockPanel Width="200" Height="35" >
                        <TextBlock Text="Extract Models" TextAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>
                </TabItem.Header>

                <UniformGrid Columns="3">
                    <DockPanel Margin="10,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Extract Models" Style="{StaticResource FieldTextBlockStyle}" />
                        <UniformGrid DockPanel.Dock="Bottom" Columns="4" Height="30">
                            <Button Command="{Binding AddExtractModelCommand}" ToolTip="Add New Model">
                                <CommonControls:FontAwesome Icon="2b" IconStyle="Light" Color="{StaticResource SuccessColour}"/>
                            </Button>
                            <Button Command="{Binding UpdateExtractModelCommand}" ToolTip="Model Settings">
                                <CommonControls:FontAwesome Icon="f0ad" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                            <Button Command="{Binding RemoveExtractModelCommand}" ToolTip="Remove Model">
                                <CommonControls:FontAwesome Icon="f2ed" IconStyle="Light" Color="{StaticResource DangerColour}"/>
                            </Button>
                            <Button Command="{Binding CopyExtractModelCommand}" ToolTip="Copy Model">
                                <CommonControls:FontAwesome Icon="f24d" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding Settings.ExtractModels}" SelectedItem="{Binding SelectedExtractModel}" ItemContainerStyle="{StaticResource SettingsListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel DockPanel.Dock="Left">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="12" Margin="3,0,0,0" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Type}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                            <TextBlock Text="OnnxRuntime" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </UniformGrid>
            </TabItem>


            <!--Upscale Models-->
            <TabItem DockPanel.Dock="Top">
                <TabItem.Header>
                    <DockPanel Width="200" Height="35" >
                        <TextBlock Text="Upscale Models" TextAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>
                </TabItem.Header>

                <UniformGrid Columns="3">
                    <DockPanel Margin="10,0,0,0">
                        <TextBlock DockPanel.Dock="Top" Text="Upscale Models" Style="{StaticResource FieldTextBlockStyle}" />
                        <UniformGrid DockPanel.Dock="Bottom" Columns="4" Height="30">
                            <Button Command="{Binding AddUpscaleModelCommand}" ToolTip="Add New Model">
                                <CommonControls:FontAwesome Icon="2b" IconStyle="Light" Color="{StaticResource SuccessColour}"/>
                            </Button>

                            <Button Command="{Binding UpdateUpscaleModelCommand}" ToolTip="Model Settings">
                                <CommonControls:FontAwesome Icon="f0ad" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                            <Button Command="{Binding RemoveUpscaleModelCommand}" ToolTip="Remove Model">
                                <CommonControls:FontAwesome Icon="f2ed" IconStyle="Light" Color="{StaticResource DangerColour}"/>
                            </Button>
                            <Button Command="{Binding CopyUpscaleModelCommand}" ToolTip="Copy Model">
                                <CommonControls:FontAwesome Icon="f24d" IconStyle="Light" Color="{StaticResource InfoColour}"/>
                            </Button>
                        </UniformGrid>
                        <ListBox ItemsSource="{Binding Settings.UpscaleModels}" SelectedItem="{Binding SelectedUpscaleModel}" ItemContainerStyle="{StaticResource SettingsListBoxItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel DockPanel.Dock="Left">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontSize="12" Margin="3,0,0,0" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding ScaleFactor, StringFormat={}x{0}}" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                            <TextBlock Text="OnnxRuntime" TextAlignment="Right" Margin="0,0,2,2" Opacity=".7" FontSize="11"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                </UniformGrid>
            </TabItem>


            <!--Footer-->
            <TabItem DockPanel.Dock="Bottom" Style="{StaticResource HiddenTabItem}" >
                <TabItem.Header>
                    <Grid Width="200">
                        <DockPanel Opacity=".7">
                            <CommonControls:FontAwesome DockPanel.Dock="Top" Icon="&#xf535;" Size="35" IconStyle="SharpThin" HorizontalAlignment="Left" />
                            <TextBlock DockPanel.Dock="Top" Text="Made in New Zealand" />
                            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom"  UseLayoutRounding="True" Orientation="Horizontal">
                                <TextBlock Text="Created By: " FontStyle="Italic"  FontSize="10" VerticalAlignment="Center" Margin="0,2,0,0" />
                                <CommonControls:HyperlinkControl Label="TensorStack Ltd" Link="https://www.tensorstack.ai" Foreground="{StaticResource AccentColour2}"/>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </TabItem.Header>
            </TabItem>
            <TabItem Style="{StaticResource HiddenTabItem}"  />
        </TabControl>
    </Grid>
</Views:ViewBase>
